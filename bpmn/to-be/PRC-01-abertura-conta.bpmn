    <bpmn:sequenceFlow id="Flow_043" name="nao sabe ou nao pode" sourceRef="GwPodeAssinar" targetRef="AssinaturaBiometrica">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=podeAssinar = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_044" name="sim" sourceRef="GwPodeAssinar" targetRef="Assinar" />
