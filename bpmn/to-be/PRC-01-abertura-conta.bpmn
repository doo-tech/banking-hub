      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=diligencia.nivel = &quot;REFORCADA&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_030" name="normal ou simplificada" sourceRef="GwDiligenciaReforcada" targetRef="GwJoinDiligencia" />
    <bpmn:sequenceFlow id="Flow_031" sourceRef="AprovarDiligenciaReforcada" targetRef="GwEddAprovada" />
    <bpmn:sequenceFlow id="Flow_032" name="nao" sourceRef="GwEddAprovada" targetRef="RecusadoRisco">
