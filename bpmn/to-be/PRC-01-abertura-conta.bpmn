<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PRC01" targetNamespace="http://bankinghub.ao/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.8.0">
  <bpmn:message id="Message_IniciarPedido" name="iniciarPedidoAbertura" />
  <bpmn:message id="Message_FundosRecebidos" name="entregaInicialFundosRecebida">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=pedidoId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_MinutaNaoConforme" name="ERRO_MINUTA_NAO_CONFORME" errorCode="ERRO_MINUTA_NAO_CONFORME" />
  <bpmn:process id="PRC-01-abertura-conta" name="PRC-01 Abertura de Conta de Deposito" isExecutable="true">
    <bpmn:startEvent id="StartPedido" name="Pedido de abertura iniciado">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Start" messageRef="Message_IniciarPedido" />
    </bpmn:startEvent>
    <bpmn:userTask id="Consentimento" name="Consentir tratamento de dados pessoais">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-consentimento" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="DeclararPerfil" name="Declarar perfil, residencia e moeda">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-declarar-perfil" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:businessRuleTask id="AvaliarElegibilidade" name="Avaliar elegibilidade">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="elegibilidade" resultVariable="elegibilidade" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GwElegivel" name="Elegivel?" default="Flow_006">
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005</bpmn:outgoing>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NaoElegivel" name="Nao elegivel">
      <bpmn:incoming>Flow_005</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="GerarChecklist" name="Gerar checklist documental">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="requisitos_documentais" resultVariable="checklist" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="CapturarDocumento" name="Capturar documento de identificacao">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-capturar-documento" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_007</bpmn:incoming>
      <bpmn:outgoing>Flow_008</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="ExtrairDadosDocumento" name="Extrair dados do documento">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kyc.extrairDadosDocumento" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_008</bpmn:incoming>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ValidarDocumento" name="Validar autenticidade e validade">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kyc.validarDocumento" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:outgoing>Flow_010</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="CapturarSelfie" name="Capturar selfie com prova de vida">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-capturar-selfie" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_010</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CorrespondenciaFacial" name="Verificar correspondencia facial">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kyc.verificarCorrespondenciaFacial" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwIdentidade" name="Identidade comprovada?" default="Flow_014">
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:outgoing>Flow_013</bpmn:outgoing>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RevisaoManualIdentidade" name="Revisao manual de identidade">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-revisao-identidade" />
        <zeebe:assignmentDefinition candidateGroups="ANALISTA_COMPLIANCE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_013</bpmn:incoming>
      <bpmn:outgoing>Flow_015</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwDuvidaPersiste" name="Duvida persiste?" default="Flow_017">
      <bpmn:incoming>Flow_015</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
      <bpmn:outgoing>Flow_017</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RecusadoIdentidade" name="Recusado: identidade nao comprovada">
      <bpmn:incoming>Flow_016</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwJoinIdentidade" name="Identidade resolvida">
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:incoming>Flow_017</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CompletarFicha" name="Confirmar e completar Ficha de Cliente">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-ficha-cliente" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_018</bpmn:incoming>
      <bpmn:outgoing>Flow_019</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="SubmeterDocumentos" name="Submeter documentos da checklist">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-submeter-documentos" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_020</bpmn:incoming>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="VerificarDocumentos" name="Verificar documentos submetidos">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="document.verificarDocumento" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=checklist" inputElement="requisito" outputCollection="verificacoes" outputElement="=verificacao" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GwChecklistCompleta" name="Checklist completa?" default="Flow_024">
      <bpmn:incoming>Flow_022</bpmn:incoming>
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="TriarPep" name="Triar PEP de todas as partes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kyc.triarPep" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_024</bpmn:incoming>
      <bpmn:outgoing>Flow_025</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=partes" inputElement="parte" outputCollection="triagensPep" outputElement="=triagem" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="RastrearSancoes" name="Rastrear sancoes">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="kyc.rastrearSancoes" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_025</bpmn:incoming>
      <bpmn:outgoing>Flow_026</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="CalcularRisco" name="Calcular risco BC/FT/FPADM">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="risco_bcft" resultVariable="risco" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_026</bpmn:incoming>
      <bpmn:outgoing>Flow_027</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:businessRuleTask id="DeterminarDiligencia" name="Determinar nivel de diligencia">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="nivel_diligencia" resultVariable="diligencia" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_027</bpmn:incoming>
      <bpmn:outgoing>Flow_028</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GwDiligenciaReforcada" name="Diligencia reforcada?" default="Flow_030">
      <bpmn:incoming>Flow_028</bpmn:incoming>
      <bpmn:outgoing>Flow_029</bpmn:outgoing>
      <bpmn:outgoing>Flow_030</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="AprovarDiligenciaReforcada" name="Aprovar diligencia reforcada">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-aprovar-diligencia-reforcada" />
        <zeebe:assignmentDefinition candidateGroups="CHEFE_COMPLIANCE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_029</bpmn:incoming>
      <bpmn:outgoing>Flow_031</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwEddAprovada" name="Aprovada?" default="Flow_033">
      <bpmn:incoming>Flow_031</bpmn:incoming>
      <bpmn:outgoing>Flow_032</bpmn:outgoing>
      <bpmn:outgoing>Flow_033</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="RecusadoRisco" name="Recusado: risco">
      <bpmn:incoming>Flow_032</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="GwJoinDiligencia" name="Diligencia concluida">
      <bpmn:incoming>Flow_030</bpmn:incoming>
      <bpmn:incoming>Flow_033</bpmn:incoming>
      <bpmn:outgoing>Flow_034</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="SelecionarRegime" name="Selecionar regime de titularidade">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-selecionar-regime" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_034</bpmn:incoming>
      <bpmn:outgoing>Flow_035</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="GerarCondicoes" name="Gerar Condicoes Gerais, Particulares e FTI">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contract.gerarCondicoes" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_035</bpmn:incoming>
      <bpmn:outgoing>Flow_036</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="ValidarCobertura" name="Validar cobertura dos 13 temas">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="cobertura_condicoes_gerais" resultVariable="cobertura" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_036</bpmn:incoming>
      <bpmn:outgoing>Flow_037</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GwCoberturaConforme" name="Minuta conforme?" default="Flow_039">
      <bpmn:incoming>Flow_037</bpmn:incoming>
      <bpmn:outgoing>Flow_038</bpmn:outgoing>
      <bpmn:outgoing>Flow_039</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="IncidenteCobertura" name="Incidente: minuta nao conforme">
      <bpmn:incoming>Flow_038</bpmn:incoming>
      <bpmn:errorEventDefinition id="EED_IncidenteCobertura" errorRef="Error_MinutaNaoConforme" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="DisponibilizarCondicoes" name="Disponibilizar Condicoes e FTI ao cliente">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contract.disponibilizarCondicoes" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_039</bpmn:incoming>
      <bpmn:outgoing>Flow_040</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ArquivarEvidencia" name="Arquivar evidencia de disponibilizacao">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="archive.arquivarEvidenciaDisponibilizacao" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_040</bpmn:incoming>
      <bpmn:outgoing>Flow_041</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ConfirmarLeitura" name="Confirmar leitura das condicoes">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-confirmar-leitura" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_041</bpmn:incoming>
      <bpmn:outgoing>Flow_042</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwPodeAssinar" name="Sabe e pode assinar?" default="Flow_044">
      <bpmn:incoming>Flow_042</bpmn:incoming>
      <bpmn:outgoing>Flow_043</bpmn:outgoing>
      <bpmn:outgoing>Flow_044</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Assinar" name="Assinar Ficha de Cliente e contrato">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-assinar" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_044</bpmn:incoming>
      <bpmn:outgoing>Flow_045</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="AssinaturaBiometrica" name="Assinar por meio biometrico">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-assinatura-biometrica" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_043</bpmn:incoming>
      <bpmn:outgoing>Flow_046</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwJoinAssinatura" name="Assinatura recolhida">
      <bpmn:incoming>Flow_045</bpmn:incoming>
      <bpmn:incoming>Flow_046</bpmn:incoming>
      <bpmn:outgoing>Flow_047</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CelebrarContrato" name="Celebrar Contrato de Abertura de Conta">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="contract.celebrarContrato" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_047</bpmn:incoming>
      <bpmn:outgoing>Flow_048</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CriarConta" name="Criar conta no core (ABERTA_NAO_ACTIVA)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="account.criarConta" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_048</bpmn:incoming>
      <bpmn:outgoing>Flow_049</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="CompensarConta" name="Encerrar conta nao activada" isForCompensation="true">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="account.encerrarContaNaoActivada" retries="3" />
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ComunicarIban" name="Comunicar IBAN e instrucoes de entrega">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notification.comunicarIban" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_049</bpmn:incoming>
      <bpmn:outgoing>Flow_050</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="GwEventoFundos" name="Aguardar entrega inicial de fundos">
      <bpmn:incoming>Flow_050</bpmn:incoming>
      <bpmn:outgoing>Flow_051</bpmn:outgoing>
      <bpmn:outgoing>Flow_052</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="FundosRecebidos" name="Fundos recebidos">
      <bpmn:incoming>Flow_051</bpmn:incoming>
      <bpmn:outgoing>Flow_055</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_Fundos" messageRef="Message_FundosRecebidos" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="PrazoFundosExpirou" name="Prazo de 15 dias expirou">
      <bpmn:incoming>Flow_052</bpmn:incoming>
      <bpmn:outgoing>Flow_053</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TED_Fundos">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P15D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="CompensarExpirado" name="Compensar conta criada">
      <bpmn:incoming>Flow_053</bpmn:incoming>
      <bpmn:outgoing>Flow_054</bpmn:outgoing>
      <bpmn:compensateEventDefinition id="CED_CompensarExpirado" activityRef="CriarConta" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="Expirado" name="Expirado">
      <bpmn:incoming>Flow_054</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="VerificarInstituicaoOrigem" name="Verificar elegibilidade da instituicao de origem">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="funding.verificarInstituicaoOrigem" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_055</bpmn:incoming>
      <bpmn:outgoing>Flow_056</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:businessRuleTask id="VerificarEntregaFundos" name="Verificar entrega inicial de fundos">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="entrega_fundos" resultVariable="entregaFundos" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_056</bpmn:incoming>
      <bpmn:outgoing>Flow_057</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="GwDecisaoFundos" name="Decisao sobre os fundos" default="Flow_060">
      <bpmn:incoming>Flow_057</bpmn:incoming>
      <bpmn:outgoing>Flow_058</bpmn:outgoing>
      <bpmn:outgoing>Flow_059</bpmn:outgoing>
      <bpmn:outgoing>Flow_060</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="RecolherJustificacao" name="Recolher justificacao credivel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-recolher-justificacao" />
        <zeebe:assignmentDefinition candidateGroups="CLIENTE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_059</bpmn:incoming>
      <bpmn:outgoing>Flow_061</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="AvaliarJustificacao" name="Avaliar justificacao credivel">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-avaliar-justificacao" />
        <zeebe:assignmentDefinition candidateGroups="ANALISTA_COMPLIANCE" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_061</bpmn:incoming>
      <bpmn:outgoing>Flow_062</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GwJustificacaoAceite" name="Justificacao aceite?" default="Flow_064">
      <bpmn:incoming>Flow_062</bpmn:incoming>
      <bpmn:outgoing>Flow_063</bpmn:outgoing>
      <bpmn:outgoing>Flow_064</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GwJoinFundos" name="Fundos verificados">
      <bpmn:incoming>Flow_060</bpmn:incoming>
      <bpmn:incoming>Flow_064</bpmn:incoming>
      <bpmn:outgoing>Flow_067</bpmn:outgoing>
    </bpmn:exclusiveGateway>
