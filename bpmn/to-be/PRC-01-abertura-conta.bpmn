    <bpmn:sequenceFlow id="Flow_057" sourceRef="VerificarEntregaFundos" targetRef="GwDecisaoFundos" />
    <bpmn:sequenceFlow id="Flow_058" name="rejeitar" sourceRef="GwDecisaoFundos" targetRef="GwJoinRecusaFundos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=entregaFundos.decisao = &quot;REJEITAR&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_059" name="exigir justificacao" sourceRef="GwDecisaoFundos" targetRef="RecolherJustificacao">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=entregaFundos.decisao = &quot;EXIGIR_JUSTIFICACAO&quot;</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_060" name="aceitar" sourceRef="GwDecisaoFundos" targetRef="GwJoinFundos" />
    <bpmn:sequenceFlow id="Flow_061" sourceRef="RecolherJustificacao" targetRef="AvaliarJustificacao" />
    <bpmn:sequenceFlow id="Flow_062" sourceRef="AvaliarJustificacao" targetRef="GwJustificacaoAceite" />
    <bpmn:sequenceFlow id="Flow_063" name="nao" sourceRef="GwJustificacaoAceite" targetRef="GwJoinRecusaFundos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=justificacaoAceite = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_064" name="sim" sourceRef="GwJustificacaoAceite" targetRef="GwJoinFundos" />
    <bpmn:sequenceFlow id="Flow_065" sourceRef="GwJoinRecusaFundos" targetRef="CompensarRecusa" />
