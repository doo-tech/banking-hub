    <bpmn:sequenceFlow id="Flow_022" sourceRef="VerificarDocumentos" targetRef="GwChecklistCompleta" />
    <bpmn:sequenceFlow id="Flow_023" name="incompleta" sourceRef="GwChecklistCompleta" targetRef="GwJoinDocumentos">
