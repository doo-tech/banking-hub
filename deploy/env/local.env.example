# Banking Hub — configuracao de ambiente local.
# Copiar para ../.env e ajustar. NAO versionar o .env.
#
# Em producao, nenhum segredo vive em ficheiro de ambiente: usa-se cofre de
# segredos, conforme o requisito nao funcional de seguranca.

PERFIL=local

POSTGRES_PASSWORD=bankinghub

OBJECTSTORE_USER=bankinghub
OBJECTSTORE_PASSWORD=bankinghub

KEYCLOAK_PASSWORD=admin

# Instituicao para desenvolvimento (ADR-0008 — tenantId obrigatorio mesmo com uma so)
BH_TENANT_PREDEFINIDO=banco-demo-ao

# Retencao documental — minimo legal de 10 anos (Anexo I, I.1 ponto 3).
# Parametrizavel apenas em sentido mais restritivo, ou seja, valores superiores.
BH_ARQUIVO_RETENCAO_ANOS=10

# Fornecedor de verificacao de identidade — ver premissa A3 e risco R-10.
# Em Fase 0 usa-se implementacao simulada.
BH_IDENTIDADE_FORNECEDOR=simulado
